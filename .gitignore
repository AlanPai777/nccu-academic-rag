# Crawler output data (large files, not source code)
# Keep only preprocessed text (~92MB); exclude HTML, PDF, logs (~8.5GB)
output/**
!output/*/
!output/*/extracted_texts.jsonl
!output/*/extracted_supplementary.jsonl
!output/*/supplementary_map.json
!output/office_contacts_index.jsonl

# Generated RAG data (regeneratable from output/)
rag/chunks.jsonl
rag/cache.db
rag/cache.db.bak
*.db.bak
rag/fts.db

# Python
venv/
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/
dist/
build/

# Logs
*.log

# Dev tools
.playwright-mcp/
.claude/
CLAUDE.md

# Environment
.env
.env.local
