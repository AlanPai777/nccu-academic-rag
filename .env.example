# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit actual keys.

# ── Provider selection ────────────────────────────────────────────────────────
# Switch between Ollama cloud and OpenRouter:
#   LLM_PROVIDER=ollama       (default)
#   LLM_PROVIDER=openrouter
LLM_PROVIDER=ollama

# ── Ollama cloud ──────────────────────────────────────────────────────────────
# 1. Sign in: ollama signin   OR create API key at https://ollama.com/settings/keys
# 2. Pull model (optional for cloud):  ollama pull gemma4:31b-cloud
# Docs: https://ollama.com/blog/cloud
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma4:31b-cloud

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get API key at: https://openrouter.ai/settings/keys
# Free models: https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ── Langfuse tracing (Prototype 3 only — optional) ────────────────────────────
# LANGFUSE_PUBLIC_KEY=...
# LANGFUSE_SECRET_KEY=...
# LANGFUSE_HOST=https://cloud.langfuse.com
